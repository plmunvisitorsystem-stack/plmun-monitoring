# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Port the Express API listens on
PORT=5000

# MySQL (XAMPP defaults: user "root", empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=landayan_ers

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Address of the React client (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173

# ----- Hosting only (leave these out on your own computer; see DEPLOY.md) -----
# Serve the built website (client/dist) from this server too: one address for everything.
# SERVE_CLIENT=true
# Cloud MySQL (e.g. Aiven) needs an encrypted connection. DB_SSL_CA is the provider's
# CA certificate (PEM text; "\n" for line breaks) so the server's identity is checked.
# DB_SSL=true
# DB_SSL_CA=
# Time zone for NOW() and new dates (Barangay Landayan time). Default +08:00.
# DB_TIME_ZONE=+08:00
# Fewer connections for small free databases. Default 10.
# DB_CONNECTION_LIMIT=5
# Keep photos in Cloudinary (private) instead of server/uploads, for hosting whose
# disk is wiped on restart. From the Cloudinary dashboard: "API environment variable".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
