# Copy this file to ".env" and fill in your own values (your own computer).
# On hosting (e.g. Railway) set the same names as the service's environment
# variables instead. Never commit the real .env file, and never put real
# passwords or secrets in this file.

# development on your computer; production on the live system
# (production also serves the website, and requires a strong JWT_SECRET)
NODE_ENV=development

# Port the server listens on (hosting platforms usually set this themselves)
PORT=5000

# MySQL (XAMPP defaults: user "root", empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=landayan_ers
# Encrypted database connection: true for cloud MySQL that requires it, false for XAMPP
DB_SSL=false

# Secret used to sign login tokens (JWT). A long random string (production: at least
# 32 characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Folder for uploaded photos (report photos and featured "after" photos).
# Leave empty on your computer (= server/uploads). On hosting, use a persistent
# volume, e.g. /data/uploads on Railway, so photos survive restarts.
UPLOAD_DIR=

# Address of the website (allowed by CORS). Development: the Vite dev server.
# Production: the live address, e.g. https://landayan-ers-production.up.railway.app
CLIENT_ORIGIN=http://localhost:5173

# ----- Optional -----
# Serve the built website from this server outside production too.
# SERVE_CLIENT=true
# The database's CA certificate, so the server's identity is checked when DB_SSL=true:
# PEM text ("\n" for line breaks) or the path of the downloaded file.
# DB_SSL_CA=
# DB_SSL_CA_FILE=
# Time zone for NOW() and new dates (Barangay Landayan time). Default +08:00.
# DB_TIME_ZONE=+08:00
# Fewer database connections for small hosted databases. Default 10.
# DB_CONNECTION_LIMIT=5
# Keep photos in Cloudinary (private) instead of UPLOAD_DIR, for hosting without a
# persistent volume. From the Cloudinary dashboard: "API environment variable".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
