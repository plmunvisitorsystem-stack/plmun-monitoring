# Dependencies
node_modules/

# Secrets - never commit the real .env (use server/.env.example)
.env
.env.*
!.env.example
*.pem
# ...except the database provider's PUBLIC CA certificate (no key inside; it only
# lets the server check that it talks to the real database).
!server/certs/*.pem

# Build output (any dist folder, e.g. client/dist/)
dist/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Uploaded report photos (user data, not source code)
server/uploads/
uploads/
